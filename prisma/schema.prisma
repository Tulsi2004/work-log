generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          String   @id @default(cuid())
  userId      String
  name        String
  ceoName     String?
  jobSource   String?
  defaultTimeFrom String?
  defaultTimeTo   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employments Employment[]

  @@unique([userId, name])
  @@index([userId])
}

// One stint of working at a company — a company can have several of these
// (e.g. rejoined later, or a designation change), each with its own pay history.
model Employment {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  designation    String?
  employmentType EmploymentType @default(FULL_TIME)
  since          DateTime?
  until          DateTime?
  paymentType    PaymentType    @default(MONTHLY)
  // Day of the month the pay lands, 1-31. Clamped to the last day in shorter
  // months, so 31 still means "month end" in February.
  payDay         Int?
  payHistory     Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workReports   WorkReport[]
  dayPlans      DayPlan[]
  salaryEntries SalaryEntry[]

  @@index([companyId])
}

model WorkReport {
  id           String     @id @default(cuid())
  userId       String
  employmentId String
  employment   Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  date     DateTime
  timeFrom String?
  timeTo   String?
  dayType  DayType   @default(OFFICE)
  wfhFrom  DateTime?
  wfhTo    DateTime?

  isLeave          Boolean   @default(false)
  isCompanyGranted Boolean   @default(false)
  leaveFrom        DateTime?
  leaveTo          DateTime?
  leaveReason      String?

  hasMeeting   Boolean @default(false)
  meetingWith  String?
  meetingTopic String?

  hasNoTask  Boolean @default(false)
  noTaskNote String?
  tasks      Json?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([employmentId])
}

enum PaymentType {
  LUMPSUM
  MONTHLY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum DayType {
  OFFICE
  WORK_FROM_HOME
  HALF_DAY
}

// A colour-coded thing to do on a given day — the planner side of the app,
// independent of whether a work report exists for that date.
model DayPlan {
  id           String      @id @default(cuid())
  userId       String
  employmentId String?
  employment   Employment? @relation(fields: [employmentId], references: [id], onDelete: SetNull)

  date   DateTime
  title  String
  detail String?
  // A built-in label key ("URGENT") or the id of a PlanLabel the user added.
  label  String  @default("GENERAL")
  isDone Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([employmentId])
}

// A label the user added on top of the built-in seven. Plans point at these by
// id, so renaming one never orphans the to-dos already wearing it.
model PlanLabel {
  id     String @id @default(cuid())
  userId String
  name   String
  // Any colour the picker produces, as #rrggbb.
  colour    String @default("#64748b")
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

// Money that landed — a salary credit, a freelance payment, a bonus — together
// with what it went on. The spends ride along as Json the way a work report
// carries its tasks: they are only ever read with the entry they belong to.
model SalaryEntry {
  id           String      @id @default(cuid())
  userId       String
  employmentId String?
  employment   Employment? @relation(fields: [employmentId], references: [id], onDelete: SetNull)

  date DateTime
  // Money is exact by nature — kept as a Decimal column and handed to the
  // client as a plain number, never as a float in the database.
  amount Decimal @db.Decimal(12, 2)
  source String?
  note   String?
  spends Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([employmentId])
}

// A field the user defined for themselves, on top of the built-in ones.
// Definitions are rows, not columns — one user adding a field never touches
// another user's data or the shape of the tables.
model CustomField {
  id     String            @id @default(cuid())
  userId String
  entity CustomFieldEntity
  name   String
  type   CustomFieldType   @default(TEXT)
  // Choice list for SELECT fields — a Json array of strings, null otherwise.
  options   Json?
  required  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values CustomFieldValue[]

  @@unique([userId, entity, name])
  @@index([userId, entity])
}

// One user-defined field's value on one record. `recordId` points at a
// WorkReport, Employment or DayPlan depending on the field's entity; it is a
// loose reference, so the delete actions clear these alongside the record.
model CustomFieldValue {
  id      String      @id @default(cuid())
  fieldId String
  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  userId   String
  recordId String
  // Every type is held as text and parsed per the field's type on read.
  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fieldId, recordId])
  @@index([userId])
  @@index([recordId])
}

enum CustomFieldEntity {
  WORK_REPORT
  EMPLOYMENT
  DAY_PLAN
  SALARY_ENTRY
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  CHECKBOX
  SELECT
}

// Small per-user settings that are not worth a table of their own — currently
// which dashboard cards are shown and in what order.
model UserPreference {
  id     String @id @default(cuid())
  userId String
  key    String
  value  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// A card the user built for themselves: one number pulled out of their own
// records, shown alongside the built-in cards. The shape of a definition — what
// counts as a source, a measure or a filter — lives in lib/custom-cards.ts; the
// row only has to survive that vocabulary changing.
model CustomCard {
  id     String @id @default(cuid())
  userId String

  title String
  // Which records to read: workReport | employment | salaryEntry | dayPlan.
  source String
  // count | sum | average | highest | lowest.
  measure String
  // What to measure: a built-in key, or a NUMBER custom field's id. Null for a count.
  field  String?
  // ALL | THIS_MONTH | THIS_YEAR | LAST_30_DAYS.
  period String @default("ALL")
  // A Json array of { field, value } a record has to match, all of them.
  filters Json

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employments Employment[]

  @@unique([userId, name])
  @@index([userId])
}

// One stint of working at a company — a company can have several of these
// (e.g. rejoined later, or a designation change), each with its own pay history.
model Employment {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  designation    String?
  employmentType EmploymentType @default(FULL_TIME)
  since          DateTime?
  until          DateTime?
  paymentType    PaymentType    @default(MONTHLY)
  payHistory     Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workReports WorkReport[]

  @@index([companyId])
}

model WorkReport {
  id           String     @id @default(cuid())
  userId       String
  employmentId String
  employment   Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  date     DateTime
  timeFrom String?
  timeTo   String?
  dayType  DayType  @default(OFFICE)

  isLeave     Boolean   @default(false)
  leaveFrom   DateTime?
  leaveTo     DateTime?
  hasMeeting  Boolean   @default(false)
  leaveReason String?

  hasNoTask  Boolean @default(false)
  noTaskNote String?
  tasks      Json?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([employmentId])
}

enum PaymentType {
  LUMPSUM
  MONTHLY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum DayType {
  OFFICE
  WORK_FROM_HOME
  HALF_DAY
}
